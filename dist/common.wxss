.picker-layer{align-items:flex-end;display:flex;inset:0;position:fixed;z-index:100}.picker-backdrop{backdrop-filter:blur(18rpx);background:rgba(19,16,22,.52);inset:0;position:absolute}.picker-sheet{animation:sheet-in .28s ease-out;background:#fbf9f6;border-radius:60rpx 60rpx 0 0;height:76vh;padding:20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));position:relative;width:100%}.picker-handle{background:#d5d0cb;border-radius:198rpx;height:8rpx;margin:0 auto 36rpx;width:76rpx}.picker-head{align-items:flex-start;display:flex;justify-content:space-between}.picker-title{font-size:52rpx;font-weight:820;letter-spacing:-1.4rpx;margin-top:10rpx}.picker-close{background:#eeeae5;border-radius:50%;font-size:50rpx;height:88rpx;width:88rpx}.picker-search{align-items:center;background:#fff;border:2rpx solid rgba(23,21,19,.08);border-radius:36rpx;display:flex;gap:20rpx;height:104rpx;margin:40rpx 0 24rpx;padding:0 34rpx}.picker-search input{flex:1;font-size:32rpx;height:104rpx}.picker-list{height:calc(76vh - 360rpx)}.picker-feedback{color:#857d78;font-size:48rpx;padding:52rpx 20rpx;text-align:center}.group-row{align-items:center;border-radius:36rpx;display:flex;min-height:144rpx;padding:18rpx 16rpx;text-align:left;width:100%}.group-row.is-selected{background:#f0ece8}.group-orb{align-items:center;border-radius:34rpx;box-shadow:inset 0 0 0 2rpx hsla(0,0%,100%,.35);color:#fff;display:flex;flex:0 0 auto;font-size:40rpx;font-weight:850;height:104rpx;justify-content:center;width:104rpx}.group-orb image{border-radius:inherit;height:100%;width:100%}.group-copy{display:flex;flex:1;flex-direction:column;gap:8rpx;margin-left:28rpx;min-width:0}.group-name{font-size:34rpx;font-weight:780}.group-label{color:#827b75;font-size:26rpx}.group-arrow{font-size:44rpx;margin-right:16rpx}@keyframes sheet-in{from{transform:translateY(100%)}to{transform:translateY(0)}}