.notice-header{padding:52rpx 44rpx 44rpx}.notice-header .title{margin:14rpx 0 18rpx}.notice-header .muted{font-size:26rpx}.notice-list{padding:8rpx 32rpx 60rpx}.today-label{font-size:26rpx;font-weight:800;margin:16rpx 10rpx 24rpx}.notice-row{align-items:flex-start;display:flex;margin-bottom:22rpx;min-height:184rpx;padding:30rpx}.notice-mark{align-items:center;border-radius:30rpx;display:flex;flex:0 0 auto;font-size:36rpx;font-weight:850;height:92rpx;justify-content:center;width:92rpx}.notice-mark.green{background:#ddf3e4;color:#2c7d47}.notice-mark.pink{background:#f8dce7;color:#b33b6b}.notice-mark.blue{background:#ddecf7;color:#346e9c}.notice-mark.sand{background:#eee4d7;color:#806344}.notice-copy{flex:1;margin-left:26rpx;min-width:0}.notice-line{align-items:center;display:flex;gap:20rpx;justify-content:space-between}.notice-title{font-size:28rpx;font-weight:800}.notice-time{color:#9b948d;flex:0 0 auto;font-size:20rpx}.notice-body{color:var(--muted);display:block;font-size:24rpx;line-height:1.5;margin-top:14rpx}