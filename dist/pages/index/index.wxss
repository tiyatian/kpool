.welcome{background:#171419;color:#fff;display:flex;flex-direction:column;min-height:100vh}.welcome-art{align-items:center;background:radial-gradient(circle at 50% 35%,#5b435e 0,#221c25 43%,#171419 72%);display:flex;flex-direction:column;justify-content:center;min-height:48vh;overflow:hidden;position:relative}.logo-seal{align-items:center;border:2rpx solid hsla(0,0%,100%,.6);border-radius:56rpx;box-shadow:inset 0 0 0 16rpx hsla(0,0%,100%,.06),0 44rpx 120rpx rgba(0,0,0,.32);display:flex;font-family:Georgia,serif;font-size:96rpx;height:184rpx;justify-content:center;position:relative;width:184rpx}.seal-star{font-size:44rpx;position:absolute;right:-24rpx;top:-28rpx}.welcome-wordmark{font-size:32rpx;font-weight:850;letter-spacing:14rpx;margin-top:40rpx}.welcome-tagline{color:hsla(0,0%,100%,.6);font-size:24rpx;letter-spacing:1.4rpx;margin-top:20rpx}.orbit{border:2rpx solid hsla(0,0%,100%,.12);border-radius:50%;position:absolute;transform:rotate(-20deg)}.orbit-one{height:240rpx;width:660rpx}.orbit-two{height:660rpx;transform:rotate(36deg);width:480rpx}.welcome-bottom{background:#f8f5f0;border-radius:64rpx 64rpx 0 0;color:var(--ink);flex:1;padding:68rpx 48rpx calc(48rpx + env(safe-area-inset-bottom))}.welcome-title{font-size:68rpx;font-weight:850;letter-spacing:-2.4rpx;line-height:1.12;margin-top:18rpx;white-space:pre-line}.welcome-copy{color:var(--muted);display:block;font-size:28rpx;line-height:1.65;margin-top:28rpx}.wechat-button{background:#171513;border-radius:36rpx;color:#fff;font-size:32rpx;font-weight:750;margin-top:56rpx;min-height:108rpx;width:100%}.wechat-mark{color:#7fe39a;font-weight:850;margin-right:20rpx}.agreement{color:#9a938c;display:block;font-size:22rpx;margin-top:30rpx;text-align:center}.home-hero{border-radius:0 0 68rpx 68rpx;color:#fff;height:850rpx;overflow:hidden;position:relative}.home-cover-image{height:100%;inset:0;position:absolute;width:100%}.home-hero::after{background:linear-gradient(180deg,rgba(17,16,17,.05),rgba(17,16,17,.46));content:"";inset:0;position:absolute}.home-hero .topbar{position:relative;z-index:3}.hero-copy{align-items:flex-start;bottom:70rpx;display:flex;flex-direction:column;left:44rpx;position:absolute;z-index:3}.hero-copy .eyebrow{color:hsla(0,0%,100%,.72)}.hero-group{font-size:84rpx;font-weight:900;letter-spacing:-4rpx;line-height:1;margin-top:14rpx}.hero-tagline{color:hsla(0,0%,100%,.78);font-size:28rpx;margin-top:20rpx}.switch-group{backdrop-filter:blur(20rpx);background:rgba(17,15,18,.35);border:2rpx solid hsla(0,0%,100%,.28);border-radius:198rpx;color:#fff;font-size:26rpx;font-weight:700;margin-top:36rpx;min-height:88rpx;padding:0 32rpx}.hero-monogram{color:hsla(0,0%,100%,.16);font-family:Georgia,serif;font-size:540rpx;line-height:1;position:absolute;right:-40rpx;top:160rpx;transform:rotate(-8deg);z-index:1}.hero-noise{background-image:radial-gradient(hsla(0,0%,100%,.7) 1rpx,transparent 0);background-size:10rpx 10rpx;inset:0;opacity:.15;position:absolute}.home-content{padding:40rpx}.quick-card{align-items:center;display:flex;justify-content:space-between;min-height:264rpx;padding:40rpx}.quick-title{font-size:42rpx;font-weight:820;margin:10rpx 0 12rpx}.quick-copy{color:var(--muted);font-size:26rpx}.quick-arrow{background:var(--ink);border-radius:36rpx;color:#fff;font-size:44rpx;height:104rpx;width:104rpx}.section-head{align-items:flex-end;display:flex;justify-content:space-between;margin:60rpx 4rpx 32rpx}.trend-grid{display:grid;gap:32rpx;grid-template-columns:1fr 1fr}.trend-item{text-align:left;width:100%}.trend-art{border-radius:44rpx;color:#fff;font-size:56rpx;font-weight:900;height:300rpx;letter-spacing:-2rpx;overflow:hidden;padding:28rpx;position:relative}.trend-cover{height:100%;inset:0;position:absolute;width:100%}.trend-art > text{opacity:0;position:relative;z-index:2}.trend-ring{border:34rpx solid hsla(0,0%,100%,.22);border-radius:50%;bottom:-36rpx;height:200rpx;position:absolute;right:-36rpx;width:200rpx}.trend-name{display:block;font-size:30rpx;font-weight:780;margin:20rpx 4rpx 6rpx}.trend-count{color:var(--muted);font-size:24rpx;margin-left:4rpx}