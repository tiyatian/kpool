.profile-hero{border-radius:0 0 68rpx 68rpx;color:#fff;height:710rpx;overflow:hidden;position:relative}.profile-hero::after{background:linear-gradient(180deg,rgba(16,14,18,.06),rgba(16,14,18,.48));content:"";inset:0;position:absolute}.profile-hero .topbar{position:relative;z-index:3}.profile-shape{color:hsla(0,0%,100%,.17);font-family:Georgia,serif;font-size:520rpx;position:absolute;right:-60rpx;top:96rpx;transform:rotate(-10deg)}.profile-identity{align-items:flex-start;bottom:60rpx;display:flex;flex-direction:column;left:44rpx;position:absolute;z-index:3}.profile-avatar{align-items:center;background:rgba(20,18,22,.72);border:2rpx solid hsla(0,0%,100%,.36);border-radius:46rpx;display:flex;font-family:Georgia,serif;font-size:62rpx;height:136rpx;justify-content:center;margin-bottom:28rpx;width:136rpx}.profile-name{font-size:54rpx;font-weight:850;letter-spacing:-1.2rpx}.profile-handle{color:hsla(0,0%,100%,.72);font-size:24rpx;margin-top:12rpx}.profile-content{padding:32rpx 36rpx 64rpx}.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);padding:36rpx 16rpx;text-align:center}.profile-stats > view + view{border-left:2rpx solid var(--line)}.stat-value{display:block;font-size:40rpx;font-weight:850}.stat-label{color:var(--muted);display:block;font-size:20rpx;margin-top:10rpx}.world-card{margin-top:28rpx;padding:38rpx}.world-title{font-size:38rpx;font-weight:820;margin-top:10rpx}.world-chips{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:30rpx}.world-chips text{align-items:center;background:#eee9e3;border-radius:198rpx;color:var(--ink);display:flex;font-size:22rpx;font-weight:750;min-height:70rpx;padding:0 24rpx}.world-chips text:first-child{color:#fff}.profile-section{margin-top:56rpx}.profile-section > .section-title{display:block;margin:0 4rpx 28rpx}.profile-menu{overflow:hidden}.menu-row{align-items:center;border-bottom:2rpx solid var(--line);color:var(--ink);display:flex;min-height:148rpx;padding:24rpx 30rpx;text-align:left;width:100%}.menu-row:last-child{border-bottom:0}.menu-icon{align-items:center;background:#f0ebe5;border-radius:26rpx;display:flex;flex:0 0 auto;font-size:34rpx;height:80rpx;justify-content:center;width:80rpx}.menu-copy{display:flex;flex:1;flex-direction:column;gap:10rpx;margin-left:24rpx;min-width:0}.menu-copy text:first-child{font-size:28rpx;font-weight:780}.menu-copy text:last-child{color:var(--muted);font-size:22rpx}.menu-arrow{font-size:44rpx}.create-profile-button{margin-top:36rpx;width:100%}