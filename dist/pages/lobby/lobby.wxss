ent(180deg,rgba(10,9,12,.08),rgba(10,9,12,.48));content:"";inset:0;position:absolute}.lobby-hero .topbar{position:relative;z-index:3}.group-switch{background:rgba(20,18,22,.28);border:2rpx solid hsla(0,0%,100%,.25);border-radius:198rpx;color:#fff;font-size:28rpx;font-weight:750;min-height:88rpx;padding:0 30rpx}.album-copy{align-items:flex-start;bottom:52rpx;display:flex;flex-direction:column;left:44rpx;position:absolute;z-index:3}.album-copy .eyebrow{color:hsla(0,0%,100%,.7)}.album-title{font-size:68rpx;font-weight:900;letter-spacing:-2.8rpx;line-height:1;margin-top:14rpx;width:560rpx}.album-stat{font-size:26rpx;margin-top:20rpx}.album-vinyl{border:68rpx solid hsla(0,0%,100%,.18);border-radius:50%;box-shadow:inset 0 0 0 4rpx hsla(0,0%,100%,.2);height:500rpx;position:absolute;right:-140rpx;top:120rpx;width:500rpx;z-index:1}.album-tabs{margin-top:24rpx;white-space:nowrap;width:100%}.album-tabs-inner{display:flex;gap:16rpx;padding:12rpx 40rpx;width:-moz-max-content;width:max-content}.album-tab{background:#ede8e2;border-radius:198rpx;color:#6e6862;font-size:24rpx;font-weight:700;min-height:84rpx;padding:0 30rpx}.album-tab.active{background:var(--ink);color:#fff}.member-section{padding:44rpx 0 8rpx}.list-head,.member-head{align-items:center;display:flex;justify-content:space-between;padding:0 40rpx 28rpx}.clear-filter{color:var(--muted);font-size:26rpx;min-height:80rpx}.member-scroll{white-space:nowrap}.member-row{display:flex;gap:20rpx;padding:0 40rpx 24rpx;width:-moz-max-content;width:max-content}.member-filter{align-items:center;background:var(--surface);border:2rpx solid var(--line);border-radius:40rpx;display:flex;flex-direction:column;min-height:232rpx;padding:22rpx 16rpx;width:176rpx}.member-filter.active{background:var(--ink);color:#fff;transform:translateY(-6rpx)}.member-glyph{align-items:center;background:#f1ece6;border-radius:28rpx;color:var(--ink);display:flex;font-size:38rpx;height:84rpx;justify-content:center;width:84rpx}.member-name{font-size:22rpx;font-weight:800;margin-top:16rpx;overflow:hidden;text-overflow:ellipsis;width:144rpx}.member-free{color:var(--muted);font-size:20rpx;margin-top:8rpx}.member-filter.active .member-free{color:hsla(0,0%,100%,.65)}.ride-list{padding:44rpx 40rpx}.list-head{padding:0 4rpx 28rpx}.empty{padding:72rpx 48rpx;text-align:center}.empty-mark{display:block;font-size:68rpx}.empty-title{display:block;font-size:36rpx;font-weight:800;margin:24rpx 0 16rpx}.empty .primary-button{margin-top:44rpx}